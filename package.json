{
  "name": "grundtone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "gen:rust-tokens": "tsx scripts/generate-rust-tokens.ts",
    "gen:rust-tokens:check": "tsx scripts/generate-rust-tokens.ts --check",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,vue,scss,css,json,md,yml,yaml}\"",
    "lint:js": "eslint \"{packages,apps,docs}/**/*.{js,jsx,ts,tsx,vue}\" --fix",
    "lint:js:check": "eslint \"{packages,apps,docs}/**/*.{js,jsx,ts,tsx,vue}\"",
    "lint:styles": "stylelint \"{packages,apps}/**/*.{scss,css,vue}\" --fix",
    "lint:styles:check": "stylelint \"{packages,apps}/**/*.{scss,css,vue}\"",
    "lint:format": "prettier --check \"**/*.{ts,tsx,vue,scss,css,json,md,yml,yaml}\"",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "docs:dev": "pnpm --filter @grundtone/docs dev",
    "docs:build": "turbo build --filter=@grundtone/docs",
    "docs:preview": "pnpm --filter @grundtone/docs preview",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status --verbose",
    "changeset:empty": "changeset add --empty",
    "version-packages": "changeset version && npx tsx scripts/add-changelog-dates.ts && pnpm install --lockfile-only",
    "release": "pnpm build:packages && changeset publish",
    "release:snapshot": "pnpm build:packages && changeset version --snapshot && changeset publish --tag snapshot --no-git-tag",
    "release:snapshot:tagged": "pnpm build:packages && changeset version --snapshot",
    "prerelease:enter": "changeset pre enter",
    "prerelease:exit": "changeset pre exit",
    "prerelease:next": "changeset pre enter next",
    "prerelease:beta": "changeset pre enter beta",
    "prerelease:alpha": "changeset pre enter alpha"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@neoconfetti/react": "^1.0.0",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "filesize": "^11.0.22",
    "husky": "^9.1.7",
    "jsdom": "30.0.0",
    "lint-staged": "^15.5.2",
    "playwright": "^1.62.0",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier": "3.9.6",
    "rimraf": "6.0.1",
    "sharp": "^0.35.3",
    "strip-ansi": "^7.1.0",
    "stylelint": "^16.23.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.12.1",
    "turbo": "2.10.7",
    "typescript": "5.8.3",
    "vite": "^8.1.5",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "2.2.10"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "10.14.0"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,scss,css,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix"
    ],
    "*.{scss,css,vue}": [
      "stylelint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "file-type": ">=16.5.4",
      "node-fetch": ">=2.6.7",
      "glob": ">=11.1.0",
      "@octokit/request-error": ">=5.1.1",
      "@octokit/request": ">=8.4.1",
      "@octokit/plugin-paginate-rest": ">=9.2.2",
      "esbuild": ">=0.28.1",
      "flatted": ">=3.4.2",
      "minimatch": ">=9.0.7",
      "node-forge": ">=1.4.0",
      "picomatch": ">=4.0.4",
      "serialize-javascript": ">=7.0.5",
      "tar": ">=7.5.21",
      "srvx": ">=0.11.13",
      "yaml": ">=2.8.3",
      "html-minifier": "npm:html-minifier-terser@^7.2.0",
      "js-cookie": ">=3.0.7",
      "defu": ">=6.1.5",
      "@xmldom/xmldom": ">=0.8.13",
      "simple-git": ">=3.36.0",
      "fast-uri": ">=3.1.4",
      "devalue": ">=5.8.1",
      "unhead": ">=2.1.13",
      "postcss": ">=8.5.18",
      "nitropack": ">=2.13.4",
      "ws": ">=8.20.1",
      "nuxt": ">=4.4.6",
      "uuid": ">=11.1.1",
      "tmp": ">=0.2.6",
      "turbo": ">=2.9.14",
      "undici": ">=6.27.0",
      "vite": ">=6.4.3",
      "svgo": ">=4.0.2",
      "markdown-it": ">=14.2.0",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=3.0.0 <3.0.6": "^3.0.6",
      "brace-expansion@>=4.0.0 <5.0.9": "^5.0.9",
      "hono@<4.12.34": ">=4.12.34",
      "lodash-es@<4.18.0": "^4.18.0",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "nanoid@<3.3.17": "^3.3.17"
    }
  },
  "repository": "KlangHaus/grundtone",
  "author": "Allan Asp <mail@allanasp.dk>"
}
