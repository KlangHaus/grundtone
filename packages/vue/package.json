{
  "name": "@grundtone/vue",
  "version": "2.24.0",
  "description": "Vue 3 UI components for Grundtone",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./css": "./dist/index.css",
    "./dist/style.css": "./dist/index.css",
    "./scss": {
      "sass": "./scss/index.scss",
      "default": "./scss/index.scss"
    },
    "./scss/lib": {
      "sass": "./scss/lib.scss",
      "default": "./scss/lib.scss"
    },
    "./scss/breakpoints": {
      "sass": "./scss/breakpoints.scss",
      "default": "./scss/breakpoints.scss"
    },
    "./scss/colors": {
      "sass": "./scss/colors.scss",
      "default": "./scss/colors.scss"
    },
    "./scss/color-palette": {
      "sass": "./scss/color-palette.scss",
      "default": "./scss/color-palette.scss"
    }
  },
  "files": [
    "dist",
    "scss"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KlangHaus/grundtone.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf .turbo node_modules dist",
    "test": "vitest",
    "prepublishOnly": "test -d dist || pnpm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@grundtone/core": "workspace:*",
    "@grundtone/design-system": "workspace:*",
    "@grundtone/icons": "workspace:*",
    "@grundtone/utils": "workspace:*",
    "@tiptap/extension-link": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/html": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@tiptap/vue-3": "^3.29.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.12.1",
    "sass": "^1.102.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
